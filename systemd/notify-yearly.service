# Versioned copy of the live unit at /etc/systemd/system/notify-yearly.service.
# Getriggert von notify-yearly.timer (1. Januar 07:00 Europe/Berlin, siehe
# main.py YEARLY_REPORT_HOUR). Siehe notify-daily.service für Details zu
# Type=oneshot/venv_notify.
[Unit]
Description=Portfolio OS – Jahres-Report (Steuerübersicht Vorjahr)
After=network.target postgresql.service

[Service]
Type=oneshot
User=administrator
WorkingDirectory=/home/administrator/portfolio_os
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/administrator/portfolio_os/.env
ExecStart=/home/administrator/portfolio_os/venv_notify/bin/python run_scheduled_job.py yearly
